{
  "framework": "vite",
  "installCommand": "npm install --prefix client2",
  "buildCommand": "npm run build --prefix client2",
  "outputDirectory": "client2/dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
